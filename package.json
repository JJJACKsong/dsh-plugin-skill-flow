{
  "name": "dsh-plugin-skill-flow",
  "version": "0.1.0",
  "description": "Visualize and edit the node flow of workflow skills in DeepSeek Harness — one flow.json next to each SKILL.md, plus loose-skill scan and cross-workspace checks. 可视化管理工作区里的技能与工作流。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "skills",
    "docs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node verify.mjs && node verify-intent.mjs && node verify-nested.mjs && node verify-editing.mjs && node verify-release.mjs",
    "test:release": "node verify-release.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "agent-skills",
    "skill",
    "workflow",
    "flowchart",
    "canvas"
  ],
  "license": "MIT",
  "author": "JJJACKsong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJJACKsong/dsh-plugin-skill-flow.git"
  },
  "homepage": "https://github.com/JJJACKsong/dsh-plugin-skill-flow#readme",
  "bugs": {
    "url": "https://github.com/JJJACKsong/dsh-plugin-skill-flow/issues"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
